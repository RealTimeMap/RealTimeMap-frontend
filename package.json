{
  "name": "realtime-map",
  "type": "module",
  "version": "0.0.2-0.0.1",
  "private": true,
  "description": "A public map where users can leave anonymous or signed messages that are displayed in real time. All events are associated with coordinates and are visible to other users on the map.",
  "productName": "RealTime Map",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "apk-build": "bun run build && bunx cap sync",
    "--------------------------------------------------------------------------------": "",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json --composite false",
    "---------------------------------------------------------------------------------": "",
    "postinstall": "simple-git-hooks"
  },
  "dependencies": {
    "@capacitor-community/file-opener": "^8.0.1",
    "@capacitor/android": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/file-transfer": "^2.0.4",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/local-notifications": "^8.2.0",
    "@iconify/vue": "^5.0.0",
    "@types/maplibre-gl": "^1.14.0",
    "@vicons/ionicons5": "^0.13.0",
    "@vueuse/core": "^14.2.1",
    "axios": "^1.13.4",
    "compare-versions": "^6.1.1",
    "html-to-image": "^1.11.13",
    "lint-staged": "^16.2.7",
    "maplibre-gl": "^5.24.0",
    "pinia": "^3.0.4",
    "socket.io-client": "^4.8.3",
    "unplugin-vue-components": "^32.0.0",
    "vue": "^3.5.32",
    "vue-i18n": "^11.3.2",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.2.0",
    "@capacitor/cli": "^8.4.1",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^25.6.0",
    "@unocss/eslint-plugin": "^66.6.8",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/tsconfig": "^0.9.1",
    "baseline-browser-mapping": "^2.10.19",
    "eslint": "^10.2.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-vue": "~10.8.0",
    "jiti": "^2.6.1",
    "naive-ui": "^2.44.1",
    "npm-run-all2": "^8.0.4",
    "sass-embedded": "^1.99.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "~6.0.2",
    "unplugin-auto-import": "^21.0.0",
    "vfonts": "^0.0.3",
    "vite": "npm:rolldown-vite@7.3.1",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vue-tsc": "^3.2.6"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "pre-push": "bun run typecheck"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
