{
  "name": "realtime-map",
  "type": "module",
  "version": "0.0.11",
  "private": true,
  "description": "A public real-time map where users drop marks with messages, photos and a lifespan. Marks appear for everyone instantly and can be discussed in comments. Around the map: profiles with levels and achievements, direct chats and push notifications. Ships as a PWA and as native Android/iOS builds via Capacitor.",
  "productName": "RealTime Map",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "apk-build": "bun run build && bunx cap sync",
    "--------------------------------------------------------------------------------": "",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json --composite false",
    "---------------------------------------------------------------------------------": "",
    "bump": "changelogen --bump",
    "release": "changelogen --release --push",
    "----------------------------------------------------------------------------------": "",
    "postinstall": "simple-git-hooks"
  },
  "dependencies": {
    "@capacitor-community/file-opener": "^8.0.1",
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/file-transfer": "^2.0.4",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@iconify/vue": "^5.0.1",
    "@types/maplibre-gl": "^1.14.0",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.18.1",
    "compare-versions": "^6.1.1",
    "html-to-image": "^1.11.13",
    "maplibre-gl": "^6.0.0",
    "pinia": "^4.0.2",
    "socket.io-client": "^4.8.3",
    "unplugin-vue-components": "^32.1.0",
    "vue": "^3.5.40",
    "vue-i18n": "^11.4.7",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.3.0",
    "@capacitor/cli": "^8.4.2",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@iconify-json/fe": "^1.2.4",
    "@iconify-json/line-md": "^1.2.16",
    "@iconify-json/lucide": "^1.2.119",
    "@iconify-json/material-symbols": "^1.2.87",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^26.1.1",
    "@unocss/eslint-plugin": "^66.7.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "baseline-browser-mapping": "^2.11.1",
    "changelogen": "^0.6.2",
    "eslint": "^10.7.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-vue": "~10.10.0",
    "jiti": "^2.7.0",
    "lint-staged": "^17.2.0",
    "npm-run-all2": "^8.0.4",
    "sass-embedded": "^1.100.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "~6.0.3",
    "unplugin-auto-import": "^21.0.0",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vue-tsc": "^3.3.8"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "commit-msg": "npx commitlint --edit $1",
    "pre-push": "bun run typecheck"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
