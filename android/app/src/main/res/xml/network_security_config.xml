<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <domain-config cleartextTrafficAllowed="true">
        <!-- Твой домен бэкенда -->
        <domain includeSubdomains="true">realtimemap.ru</domain>
        <!-- Локалхост самого приложения -->
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
    <base-config cleartextTrafficAllowed="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
